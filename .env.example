# MySQL (la base debe existir y el usuario debe tener permisos de ALTER para migrar envios)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Arinc_Engers
DB_TABLE=envios
PORT=3000

# Puerto del adaptador ARINC429. El envío permanece desactivado por defecto.
SERIAL_ENABLED=false
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD_RATE=100000
